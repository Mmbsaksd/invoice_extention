{
    "manifest_version": 3,
    "name": "SAP Invoice Automator",
    "version": "1.0",
    "description": "Extract invoices and autofill SAP fields.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_popup": "popup/popup.html"
    },
    "background": {
        "service_worker": "background/background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "selector.js",
                "content_script/content.js"
            ]
        }
    ]
}